# Ollama Cloud settings. Copy this file to .env and add your own API key.
OLLAMA_API_KEY=replace_with_your_ollama_api_key
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=https://ollama.com

# Embedding and vector-store settings.
# Changing the embedding model requires resetting and re-ingesting Chroma.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
PERSIST_DIRECTORY=chroma_db

# Text chunking settings. Re-ingest documents after changing these values.
CHUNK_SIZE=400
CHUNK_OVERLAP=50
